---
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Real-time probabilistic tracking of global macroeconomic, technological, and geopolitical milestones on OddsPulse.net.",
  image = "https://oddspulse.net/og-image.jpg" 
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://oddspulse.net";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: { title: title, type: "website", image: image, url: canonicalURL },
        image: { alt: "OddsPulse.net Preview" }
      }}
      twitter={{
        creator: "@oddspulse",
        card: "summary_large_image",
        title: title,
        description: description,
        image: image,
      }}
      extend={{
        meta: [
          { name: "theme-color", content: "#080C14" },
          { name: "author", content: "OddsPulse.net" }
        ]
      }}
    />

    <style>
      :root {
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      body {
        background-color: #080C14;
        color: #F3F4F6;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .wrapper {
        max-width: 64rem;
        margin: 0 auto;
        padding: 2rem 1rem;
        width: 100%;
        flex: 1;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(31, 41, 55, 0.8);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(31, 41, 55, 0.8);
        text-align: center;
        font-size: 0.75rem;
        color: #9CA3AF;
      }
      a {
        text-decoration: none;
        color: inherit;
      }
      /* Custom glowing card & UI utilities */
      .neon-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        background: rgba(6, 182, 212, 0.1);
        border: 1px solid rgba(6, 182, 212, 0.3);
        color: #22d3ee;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        box-shadow: 0 0 20px rgba(6, 182, 212, 0.15);
      }
      .terminal-card {
        background: linear-gradient(to bottom right, #121A2C, #0A0F1D, #080C14);
        border: 1px solid rgba(31, 41, 55, 0.9);
        border-radius: 1.5rem;
        padding: 1.5rem;
        transition: all 0.2s ease;
        position: relative;
        overflow: hidden;
      }
      .terminal-card:hover {
        border-color: rgba(6, 182, 212, 0.5);
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.15);
      }
      .search-input {
        width: 100%;
        background: #0D1322;
        border: 1px solid #1F2937;
        color: #F3F4F6;
        font-size: 0.75rem;
        border-radius: 0.75rem;
        padding: 0.65rem 1rem 0.65rem 2.25rem;
        outline: none;
        transition: border-color 0.2s;
      }
      .search-input:focus {
        border-color: #06b6d4;
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <div class="wrapper">
      <header>
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="height: 2.25rem; width: 2.25rem; border-radius: 0.75rem; background: linear-gradient(to top right, #06b6d4, #10b981); padding: 2px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(6,182,212,0.3);">
            <div style="height: 100%; width: 100%; background: #080C14; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
              <span style="color: #22d3ee; font-weight: 800; font-size: 0.875rem;">OP</span>
            </div>
          </div>
          <span style="font-size: 1.125rem; font-weight: 800; letter-spacing: -0.025em; color: #ffffff;">
            Odds<span style="color: #22d3ee;">Pulse</span>.net
          </span>
        </a>
        <div>
          <span style="font-size: 11px; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(8, 51, 68, 0.6); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3);">
            ● LIVE FEED
          </span>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>© {new Date().getFullYear()} OddsPulse.net — Real-time Predictive Markets & Telemetry Engine.</p>
      </footer>
    </div>
  </body>
</html>
