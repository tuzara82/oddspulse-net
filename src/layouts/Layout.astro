---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="OddsPulse.net - High-end predictive fintech & Web3 telemetry terminal." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body style="background-color: var(--bg-primary); color: var(--text-primary); min-height: 100vh; display: flex; flex-direction: column; font-family: system-ui, -apple-system, sans-serif;">
    
    <!-- Top Terminal Navigation Bar -->
    <header style="border-bottom: 1px solid rgba(var(--accent-rgb), 0.2); background: rgba(10, 15, 29, 0.8); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 50;">
      <div style="max-width: 1400px; margin: 0 auto; padding: 0.85rem 1.5rem; display: flex; align-items: center; justify-content: space-between;">
        
        <!-- Logo & Status -->
        <div style="display: flex; align-items: center; gap: 1.5rem;">
          <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-size: 1.25rem; font-weight: 900; background: linear-gradient(135deg, var(--accent), #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -0.05em;">OddsPulse<span style="color: var(--accent);">.net</span></span>
          </a>
          <span style="font-size: 0.65rem; font-weight: 700; background: rgba(var(--accent-rgb), 0.15); color: var(--accent); padding: 0.2rem 0.6rem; border-radius: 9999px; border: 1px solid rgba(var(--accent-rgb), 0.3);">
            TERMINAL V4.8
          </span>
        </div>

        <!-- Right Controls: Accent Customizer & Live Status -->
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: #9CA3AF; background: #030712; padding: 0.3rem 0.75rem; border-radius: 9999px; border: 1px solid #1F2937;">
            <span style="height: 0.5rem; width: 0.5rem; background: #34d399; border-radius: 9999px; display: inline-block; box-shadow: 0 0 8px #34d399; animation: pulse 2s infinite;"></span>
            <span>Gamma / Binance Feed Online</span>
          </div>

          <!-- Neon Accent Theme Switcher -->
          <div style="display: flex; align-items: center; gap: 0.35rem; background: #030712; padding: 0.25rem 0.5rem; border-radius: 9999px; border: 1px solid #1F2937;">
            <span style="font-size: 0.65rem; color: #6B7280; font-weight: 700; padding-left: 0.2rem;">THEME:</span>
            <button class="theme-btn" data-accent="#06b6d4" data-rgb="6, 182, 212" style="width: 14px; height: 14px; border-radius: 50%; background: #06b6d4; border: none; cursor: pointer;" title="Cyan Neon"></button>
            <button class="theme-btn" data-accent="#34d399" data-rgb="52, 211, 153" style="width: 14px; height: 14px; border-radius: 50%; background: #34d399; border: none; cursor: pointer;" title="Emerald Web3"></button>
            <button class="theme-btn" data-accent="#fbbf24" data-rgb="251, 191, 36" style="width: 14px; height: 14px; border-radius: 50%; background: #fbbf24; border: none; cursor: pointer;" title="Gold Alpha"></button>
            <button class="theme-btn" data-accent="#f43f5e" data-rgb="244, 63, 94" style="width: 14px; height: 14px; border-radius: 50%; background: #f43f5e; border: none; cursor: pointer;" title="Crimson Risk"></button>
            <button class="theme-btn" data-accent="#c084fc" data-rgb="192, 132, 252" style="width: 14px; height: 14px; border-radius: 50%; background: #c084fc; border: none; cursor: pointer;" title="Purple Cyber"></button>
          </div>
        </div>

      </div>
    </header>

    <!-- Main Content Slot -->
    <main style="flex: 1; max-width: 1400px; width: 100%; margin: 0 auto; padding: 2rem 1.5rem;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid rgba(156, 163, 175, 0.1); padding: 1.5rem 0; margin-top: auto; background: rgba(3, 7, 18, 0.5);">
      <div style="max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: #6B7280; flex-wrap: wrap; gap: 1rem;">
        <div>© 2026 OddsPulse.net — Real-time Predictive Markets & Telemetry</div>
        <div style="display: flex; gap: 1.5rem;">
          <a href="/" style="color: #9CA3AF; text-decoration: none;">Terminal</a>
          <a href="https://coingecko.com" target="_blank" rel="noopener" style="color: #9CA3AF; text-decoration: none;">CoinGecko API</a>
          <a href="https://polymarket.com" target="_blank" rel="noopener" style="color: #9CA3AF; text-decoration: none;">Gamma Markets</a>
        </div>
      </div>
    </footer>

    <!-- DYNAMIC LIVE TOAST ALERTS SYSTEM (Bottom Left) -->
    <div id="live-toast-container" style="position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: 100; display: flex; flex-direction: column; gap: 0.75rem; pointer-events: none; max-width: 340px;">
      <div id="live-toast" style="background: linear-gradient(135deg, #121A2C, #0A0F1D); border: 1px solid rgba(var(--accent-rgb), 0.4); border-radius: 1rem; padding: 0.85rem 1rem; box-shadow: 0 10px 25px rgba(0,0,0,0.5); opacity: 0; transform: translateY(20px); transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); pointer-events: auto;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.25rem;">
          <span style="font-size: 0.6rem; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em;" id="toast-tag">⚡ TELEMETRY ALERT</span>
          <span style="font-size: 0.6rem; color: #6B7280;" id="toast-time">Just now</span>
        </div>
        <p style="font-size: 0.75rem; color: #ffffff; margin: 0; font-weight: 600; line-height: 1.35;" id="toast-text">
          Initializing telemetry data streams...
        </p>
      </div>
    </div>

    <!-- Persistent Theme & Dynamic Toast Script -->
    <script>
      // Theme Switcher Logic
      const themeButtons = document.querySelectorAll('.theme-btn');
      const root = document.documentElement;

      const savedAccent = localStorage.getItem('oddspulse_accent');
      const savedRgb = localStorage.getItem('oddspulse_rgb');

      if (savedAccent && savedRgb) {
        root.style.setProperty('--accent', savedAccent);
        root.style.setProperty('--accent-rgb', savedRgb);
      }

      themeButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const accent = (e.currentTarget as HTMLElement).getAttribute('data-accent');
          const rgb = (e.currentTarget as HTMLElement).getAttribute('data-rgb');
          if (accent && rgb) {
            root.style.setProperty('--accent', accent);
            root.style.setProperty('--accent-rgb', rgb);
            localStorage.setItem('oddspulse_accent', accent);
            localStorage.setItem('oddspulse_rgb', rgb);
          }
        });
      });

      // Randomized Dynamic Toast Alerts
      const toastPool = [
        { tag: "🐋 WHALE ALERT", text: "5,420 BTC ($455M) transferred from unknown wallet to Binance cold storage." },
        { tag: "📈 PROBABILITY SHIFT", text: "SpaceX Mars uncrewed landing odds surged +4% following successful orbital refueling test." },
        { tag: "🧠 AI SENTIMENT", text: "Model telemetry detects bullish accumulation wave across tier-1 crypto derivatives." },
        { tag: "🚀 SPACE & SCIENCE", text: "James Webb Space Telescope captures high-resolution atmospheric transmission spectra on K2-18b." },
        { tag: "⚡ MACRO UPDATE", text: "G20 central banks evaluate cross-border CBDC settlement framework trials." },
        { tag: "💡 SYSTEM 2 BOT", text: "Jev Autonomous Agent successfully executed paper trade on Kraken IPO probability index." },
        { tag: "🌐 GEOPOLITICS", text: "Northern Sea Route commercial cargo transit metrics indicate record ice-free shipping window." },
        { tag: "🤖 AGI MILESTONE", text: "Autonomous coding agent network resolves 89% of complex benchmark logic puzzles." }
      ];

      const toastEl = document.getElementById('live-toast');
      const toastTag = document.getElementById('toast-tag');
      const toastText = document.getElementById('toast-text');
      const toastTime = document.getElementById('toast-time');

      function showRandomToast() {
        if (!toastEl || !toastTag || !toastText || !toastTime) return;

        const randomItem = toastPool[Math.floor(Math.random() * toastPool.length)];
        toastTag.textContent = randomItem.tag;
        toastText.textContent = randomItem.text;
        toastTime.textContent = "Just now";

        toastEl.style.opacity = '1';
        toastEl.style.transform = 'translateY(0)';

        setTimeout(() => {
          toastEl.style.opacity = '0';
          toastEl.style.transform = 'translateY(20px)';
        }, 5500);
      }

      setTimeout(() => {
        showRandomToast();
        setInterval(showRandomToast, 13000);
      }, 3000);
    </script>
  </body>
</html>
