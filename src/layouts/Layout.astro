---
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Real-time probabilistic tracking of global macroeconomic, technological, and geopolitical milestones on OddsPulse.net.",
  image = "https://oddspulse.net/og-image.jpg" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Astro SEO Integration -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: image,
          url: canonicalURL,
        },
        image: {
          alt: "OddsPulse.net Preview",
        }
      }}
      twitter={{
        creator: "@oddspulse",
        card: "summary_large_image",
        title: title,
        description: description,
        image: image,
      }}
      extend={{
        meta: [
          { name: "theme-color", content: "#080C14" },
          { name: "author", content: "OddsPulse.net" }
        ]
      }}
    />

    <slot name="head" />
  </head>
  <body class="bg-[#080C14] text-gray-100 min-h-screen font-sans selection:bg-cyan-500 selection:text-gray-950">
    <div class="max-w-5xl mx-auto px-4 py-8">
      <!-- Header -->
      <header class="mb-8 flex items-center justify-between border-b border-gray-800/80 pb-6">
        <a href="/" class="flex items-center gap-2 group">
          <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-emerald-400 p-0.5 flex items-center justify-center shadow-[0_0_20px_rgba(6,182,212,0.3)]">
            <div class="h-full w-full bg-[#080C14] rounded-[10px] flex items-center justify-center">
              <span class="text-cyan-400 font-extrabold text-sm">OP</span>
            </div>
          </div>
          <span class="text-lg font-extrabold tracking-tight text-white group-hover:text-cyan-400 transition-colors">
            Odds<span class="text-cyan-400">Pulse</span>.net
          </span>
        </a>
        <div class="flex items-center gap-3">
          <span class="text-[11px] font-semibold px-3 py-1 rounded-full bg-cyan-950/60 text-cyan-400 border border-cyan-500/30">
            ● LIVE FEED
          </span>
        </div>
      </header>

      <!-- Main Content Slot -->
      <main>
        <slot />
      </main>

      <!-- Footer -->
      <footer class="mt-16 pt-6 border-t border-gray-800/80 text-center text-xs text-gray-500">
        <p>© {new Date().getFullYear()} OddsPulse.net — Real-time Predictive Markets & Telemetry Engine.</p>
      </footer>
    </div>
  </body>
</html>
