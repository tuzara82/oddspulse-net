---
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Real-time probabilistic tracking of global macroeconomic, technological, and geopolitical milestones on OddsPulse.net."
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : "https://oddspulse.net";
---

<!doctype html>
<html lang="en" data-theme="cyan">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: { title: title, type: "website", image: "https://oddspulse.net/og-image.jpg", url: canonicalURL }
      }}
    />

    <style is:global>
      :root {
        --accent: #22d3ee;
        --accent-rgb: 6, 182, 212;
        --accent-bg: rgba(8, 51, 68, 0.4);
      }
      [data-theme="emerald"] {
        --accent: #34d399;
        --accent-rgb: 16, 185, 129;
        --accent-bg: rgba(2, 44, 34, 0.4);
      }
      [data-theme="amber"] {
        --accent: #fbbf24;
        --accent-rgb: 245, 158, 11;
        --accent-bg: rgba(69, 26, 3, 0.4);
      }
      [data-theme="purple"] {
        --accent: #c084fc;
        --accent-rgb: 168, 85, 247;
        --accent-bg: rgba(76, 29, 149, 0.4);
      }

      body {
        background-color: #080C14;
        color: #F3F4F6;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0; padding: 0;
        min-height: 100vh;
        display: flex; flex-direction: column;
      }
      .app-container {
        max-width: 64rem; margin: 0 auto; padding: 2rem 1rem; width: 100%; flex: 1;
      }
      header {
        display: flex; align-items: center; justify-content: space-between;
        border-bottom: 1px solid rgba(31, 41, 55, 0.8);
        padding-bottom: 1.5rem; margin-bottom: 2rem;
      }
      footer {
        margin-top: 4rem; padding-top: 1.5rem;
        border-top: 1px solid rgba(31, 41, 55, 0.8);
        text-align: center; font-size: 0.75rem; color: #9CA3AF;
      }
      a { text-decoration: none; color: inherit; }

      .badge-live {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.25rem 0.75rem; border-radius: 9999px;
        background: var(--accent-bg);
        border: 1px solid rgba(var(--accent-rgb), 0.3);
        color: var(--accent); font-size: 0.75rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em;
        box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.15);
      }
      .bento-card {
        background: linear-gradient(to bottom right, #121A2C, #0A0F1D, #080C14);
        border: 1px solid rgba(31, 41, 55, 0.9);
        border-radius: 1.5rem; padding: 1.5rem;
        cursor: pointer; transition: all 0.2s ease;
        position: relative; overflow: hidden;
      }
      .bento-card:hover {
        border-color: rgba(var(--accent-rgb), 0.6);
        box-shadow: 0 0 25px rgba(var(--accent-rgb), 0.2);
        transform: translateY(-2px);
      }
      .search-box {
        width: 100%; background: #0D1322; border: 1px solid #1F2937;
        color: #F3F4F6; font-size: 0.8rem; border-radius: 0.75rem;
        padding: 0.75rem 1rem 0.75rem 2.5rem; outline: none; transition: border-color 0.2s;
      }
      .search-box:focus { border-color: var(--accent); box-shadow: 0 0 15px rgba(var(--accent-rgb), 0.2); }
      .filter-btn {
        background: #121A2C; border: 1px solid #1F2937; color: #D1D5DB;
        padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.75rem;
        font-weight: 600; cursor: pointer; transition: all 0.2s; white-space: nowrap;
      }
      .filter-btn.active {
        background: var(--accent); color: #030712; border-color: var(--accent);
        box-shadow: 0 0 15px rgba(var(--accent-rgb), 0.3);
      }
      .profiler-widget {
        position: fixed; bottom: 1rem; right: 1rem; z-index: 50;
        background: rgba(12, 18, 32, 0.95); border: 1px solid rgba(var(--accent-rgb), 0.4);
        backdrop-filter: blur(12px); border-radius: 1rem; padding: 1rem;
        box-shadow: 0 0 30px rgba(var(--accent-rgb), 0.2); max-width: 280px;
      }
      /* Live Toast Alert Styles */
      .toast-alert {
        position: fixed; bottom: 1rem; left: 1rem; z-index: 50;
        background: rgba(12, 18, 32, 0.95); border: 1px solid rgba(var(--accent-rgb), 0.5);
        backdrop-filter: blur(12px); border-radius: 1rem; padding: 0.85rem 1.15rem;
        box-shadow: 0 0 25px rgba(var(--accent-rgb), 0.25); max-width: 320px;
        display: flex; align-items: center; gap: 0.75rem;
        transform: translateY(150%); opacity: 0; transition: transform 0.3s ease, opacity 0.3s ease;
      }
      .toast-alert.show {
        transform: translateY(0); opacity: 1;
      }
      .theme-dot {
        width: 14px; height: 14px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; transition: transform 0.2s;
      }
      .theme-dot:hover { transform: scale(1.2); }
    </style>
  </head>
  <body>
    <div class="app-container">
      <header>
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="height: 2.25rem; width: 2.25rem; border-radius: 0.75rem; background: linear-gradient(to top right, var(--accent), #10b981); padding: 2px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(var(--accent-rgb),0.3);">
            <div style="height: 100%; width: 100%; background: #080C14; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
              <span style="color: var(--accent); font-weight: 800; font-size: 0.875rem;">OP</span>
            </div>
          </div>
          <span style="font-size: 1.125rem; font-weight: 800; color: #ffffff; letter-spacing: -0.025em;">
            Odds<span style="color: var(--accent);">Pulse</span>.net
          </span>
        </a>

        <!-- Theme Switcher Dots -->
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <span style="font-size: 0.7rem; color: #9CA3AF; font-weight: 600; text-transform: uppercase;">Theme:</span>
          <div style="display: flex; gap: 0.4rem;" id="theme-switcher">
            <div class="theme-dot" data-theme-value="cyan" style="background: #22d3ee;" title="Cyber Cyan"></div>
            <div class="theme-dot" data-theme-value="emerald" style="background: #34d399;" title="Emerald Green"></div>
            <div class="theme-dot" data-theme-value="amber" style="background: #fbbf24;" title="Gold Amber"></div>
            <div class="theme-dot" data-theme-value="purple" style="background: #c084fc;" title="Laser Purple"></div>
          </div>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>© {new Date().getFullYear()} OddsPulse.net — Real-time Predictive Markets & Telemetry Engine.</p>
      </footer>
    </div>

    <!-- Live Toast Alert Element -->
    <div class="toast-alert" id="live-toast">
      <span style="font-size: 1.25rem;" id="toast-icon">⚡</span>
      <div>
        <div style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase; color: var(--accent); letter-spacing: 0.05em;" id="toast-title">Live Telemetry Update</div>
        <div style="font-size: 0.75rem; color: #F3F4F6; font-weight: 600;" id="toast-message">Market probabilities adjusting...</div>
      </div>
    </div>

    <script>
      // Theme Management
      const savedTheme = localStorage.getItem('oddspulse_theme') || 'cyan';
      document.documentElement.setAttribute('data-theme', savedTheme);

      document.querySelectorAll('.theme-dot').forEach(dot => {
        dot.addEventListener('click', (e) => {
          const theme = (e.currentTarget as HTMLElement).getAttribute('data-theme-value');
          if (theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('oddspulse_theme', theme);
          }
        });
      });

      // Live Market Toast Alerts System
      const alerts = [
        { icon: "⚡", title: "AGI Milestone Surge", msg: "Model release velocity increased probability by +2%." },
        { icon: "🐋", title: "Whale Alert", msg: "5,000 BTC moved to cold storage from institutional reserves." },
        { icon: "📈", title: "Crypto ETP Inflow", msg: "Global spot ETF volume crossed daily records." },
        { icon: "🌍", title: "Geopolitical Shift", msg: "New trade corridor agreement submitted for ratification." },
        { icon: "🤖", title: "Robotics Cost Curve", msg: "Actuator production efficiency improved by 4%." }
      ];

      const toast = document.getElementById('live-toast');
      const toastIcon = document.getElementById('toast-icon');
      const toastTitle = document.getElementById('toast-title');
      const toastMessage = document.getElementById('toast-message');

      function showRandomAlert() {
        if (!toast || !toastIcon || !toastTitle || !toastMessage) return;
        const randomAlert = alerts[Math.floor(Math.random() * alerts.length)];
        toastIcon.textContent = randomAlert.icon;
        toastTitle.textContent = randomAlert.title;
        toastMessage.textContent = randomAlert.msg;

        toast.classList.add('show');

        setTimeout(() => {
          toast.classList.remove('show');
        }, 5000); // Shows for 5 seconds
      }

      // Trigger first alert after 4 seconds, then every 18 seconds
      setTimeout(showRandomAlert, 4000);
      setInterval(showRandomAlert, 18000);
    </script>
  </body>
</html>
