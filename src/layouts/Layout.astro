---
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Real-time probabilistic tracking of global macroeconomic, technological, and geopolitical milestones on OddsPulse.net."
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : "https://oddspulse.net";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: { title: title, type: "website", image: "https://oddspulse.net/og-image.jpg", url: canonicalURL }
      }}
    />

    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        background-color: #080C14;
        color: #F3F4F6;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0; padding: 0;
        min-height: 100vh;
        display: flex; flex-direction: column;
      }
      .app-container {
        max-width: 64rem; margin: 0 auto; padding: 2rem 1rem; width: 100%; flex: 1;
      }
      header {
        display: flex; align-items: center; justify-content: space-between;
        border-bottom: 1px solid rgba(31, 41, 55, 0.8);
        padding-bottom: 1.5rem; margin-bottom: 2rem;
      }
      footer {
        margin-top: 4rem; padding-top: 1.5rem;
        border-top: 1px solid rgba(31, 41, 55, 0.8);
        text-align: center; font-size: 0.75rem; color: #9CA3AF;
      }
      a { text-decoration: none; color: inherit; }
      
      /* UI Components */
      .badge-live {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.25rem 0.75rem; border-radius: 9999px;
        background: rgba(6, 182, 212, 0.1);
        border: 1px solid rgba(6, 182, 212, 0.3);
        color: #22d3ee; font-size: 0.75rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em;
        box-shadow: 0 0 20px rgba(6,182,212,0.15);
      }
      .bento-card {
        background: linear-gradient(to bottom right, #121A2C, #0A0F1D, #080C14);
        border: 1px solid rgba(31, 41, 55, 0.9);
        border-radius: 1.5rem; padding: 1.5rem;
        cursor: pointer; transition: all 0.2s ease;
        position: relative; overflow: hidden;
      }
      .bento-card:hover {
        border-color: rgba(6, 182, 212, 0.6);
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.2);
        transform: translateY(-2px);
      }
      .search-box {
        width: 100%; background: #0D1322; border: 1px solid #1F2937;
        color: #F3F4F6; font-size: 0.8rem; border-radius: 0.75rem;
        padding: 0.75rem 1rem 0.75rem 2.5rem; outline: none; transition: border-color 0.2s;
      }
      .search-box:focus { border-color: #06b6d4; box-shadow: 0 0 15px rgba(6,182,212,0.2); }
      .prediction-item {
        background: linear-gradient(to right, #121A2C, #0A0F1D);
        border: 1px solid rgba(31, 41, 55, 0.8);
        border-radius: 1rem; padding: 1rem 1.25rem;
        margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between;
        transition: all 0.2s;
      }
      .prediction-item:hover {
        border-color: rgba(6, 182, 212, 0.4);
        box-shadow: 0 0 20px rgba(6,182,212,0.1);
      }
      .filter-btn {
        background: #121A2C; border: 1px solid #1F2937; color: #D1D5DB;
        padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.75rem;
        font-weight: 600; cursor: pointer; transition: all 0.2s; white-space: nowrap;
      }
      .filter-btn.active {
        background: #06b6d4; color: #030712; border-color: #22d3ee;
        box-shadow: 0 0 15px rgba(6,182,212,0.3);
      }
      .profiler-widget {
        position: fixed; bottom: 1rem; right: 1rem; z-index: 50;
        background: rgba(12, 18, 32, 0.95); border: 1px solid rgba(6, 182, 212, 0.4);
        backdrop-filter: blur(12px); border-radius: 1rem; padding: 1rem;
        box-shadow: 0 0 30px rgba(6,182,212,0.2); max-width: 280px;
      }
    </style>
  </head>
  <body>
    <div class="app-container">
      <header>
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="height: 2.25rem; width: 2.25rem; border-radius: 0.75rem; background: linear-gradient(to top right, #06b6d4, #10b981); padding: 2px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(6,182,212,0.3);">
            <div style="height: 100%; width: 100%; background: #080C14; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
              <span style="color: #22d3ee; font-weight: 800; font-size: 0.875rem;">OP</span>
            </div>
          </div>
          <span style="font-size: 1.125rem; font-weight: 800; color: #ffffff; letter-spacing: -0.025em;">
            Odds<span style="color: #22d3ee;">Pulse</span>.net
          </span>
        </a>
        <span class="badge-live">● Live Telemetry Active</span>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>© {new Date().getFullYear()} OddsPulse.net — Real-time Predictive Markets & Telemetry Engine.</p>
      </footer>
    </div>
  </body>
</html>
