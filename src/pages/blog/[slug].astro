---
import Layout '../../layouts/Layout.astro';
import posts from '../../data/posts.json';

export async function getStaticPaths() {
  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout title={`${post.title} - OddsPulse.net`}>
  <div style="margin-bottom: 1.5rem;">
    <a href="/blog" style="font-size: 0.75rem; color: var(--accent); font-weight: 600;">← Back to Research Dispatches</a>
  </div>

  <article class="bento-card" style="max-width: 800px; margin: 0 auto; padding: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <span style="font-size: 0.7rem; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(var(--accent-rgb), 0.15); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), 0.3);">
        {post.category}
      </span>
      <span style="font-size: 0.75rem; color: #6B7280;">{post.date} • Author: {post.author}</span>
    </div>

    <h1 style="font-size: 2rem; font-weight: 800; margin: 0 0 1.5rem 0; color: #ffffff; line-height: 1.3;">
      {post.title}
    </h1>

    <div style="width: 100%; height: 1px; background: rgba(156, 163, 175, 0.2); margin-bottom: 1.5rem;"></div>

    <div style="font-size: 0.95rem; color: #D1D5DB; line-height: 1.8; display: flex; flex-direction: column; gap: 1.25rem;">
      <p style="margin: 0; font-size: 1.05rem; color: #ffffff; font-weight: 500;">
        {post.summary}
      </p>
      <p style="margin: 0;">
        {post.content}
      </p>
    </div>
  </article>
</Layout>
