---
import Layout from '../../layouts/Layout.astro';
import posts from '../../data/posts.json';
---

<Layout title="Telemetry Research & Blog - OddsPulse.net">
  <div style="margin-bottom: 2rem;">
    <a href="/" style="font-size: 0.75rem; color: var(--accent); font-weight: 600;">← Back to Terminal Feed</a>
  </div>

  <div style="margin-bottom: 2.5rem;">
    <div class="badge-live" style="margin-bottom: 1rem;">
      <span style="height: 0.5rem; width: 0.5rem; background: var(--accent); border-radius: 9999px; display: inline-block; box-shadow: 0 0 10px var(--accent);"></span>
      Research & Dispatches
    </div>
    <h1 style="font-size: 2.5rem; font-weight: 800; margin: 0 0 0.75rem 0; color: #ffffff;">
      Telemetry <span style="background: linear-gradient(to right, var(--accent), #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Blog & Insights</span>
    </h1>
    <p style="color: #9CA3AF; font-size: 0.95rem; max-width: 42rem; line-height: 1.5; margin: 0;">
      Deep-dive analytical research, automated trading bot insights, and macroeconomic commentary generated by the OddsPulse intelligence grid.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    {posts.map((post: any) => (
      <a href={`/blog/${post.slug}`} style="text-decoration: none; display: block;">
        <div class="bento-card" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 9999px; background: rgba(var(--accent-rgb), 0.15); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), 0.3);">
              {post.category}
            </span>
            <span style="font-size: 0.75rem; color: #6B7280;">{post.date} • By {post.author}</span>
          </div>
          
          <h2 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0; line-height: 1.4;">
            {post.title}
          </h2>

          <p style="font-size: 0.85rem; color: #9CA3AF; margin: 0; line-height: 1.5;">
            {post.summary}
          </p>

          <div style="font-size: 0.75rem; font-weight: 700; color: var(--accent); margin-top: 0.5rem;">
            Read full dispatch →
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>
