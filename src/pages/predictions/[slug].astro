---
import Layout from '../../layouts/Layout.astro';
import predictions from '../../data/predictions.json';

export async function getStaticPaths() {
  return predictions.map((item: any) => ({
    params: { slug: item.slug },
    props: { prediction: item },
  }));
}

const { prediction } = Astro.props;

// SEO Optimizations to satisfy Ahrefs and search engines
const seoTitle = `${prediction.title.substring(0, 50)}... | OddsPulse`;
const seoDescription = `${prediction.summary.substring(0, 140)} Live odds: ${prediction.odds}%. Track real-time telemetry on OddsPulse.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <div style="margin-bottom: 2rem;">
    <a href="/" style="font-size: 0.75rem; color: var(--accent); font-weight: 600; text-decoration: none;">← Back to Terminal Feed</a>
  </div>

  <div style="max-width: 800px; margin: 0 auto;">
    <div class="bento-card" style="display: flex; flex-direction: column; gap: 1.5rem; padding: 2.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
        <span style="font-size: 0.75rem; font-weight: 800; padding: 0.3rem 0.85rem; border-radius: 9999px; background: rgba(var(--accent-rgb), 0.2); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), 0.4); text-transform: uppercase;">
          {prediction.category}
        </span>
        <span style="font-size: 0.8rem; font-weight: 700; color: #34d399; background: #022c22; padding: 0.3rem 0.75rem; border-radius: 0.5rem; border: 1px solid rgba(52,211,153,0.3);">
          Change: {prediction.change}
        </span>
      </div>

      <h1 style="font-size: 2.25rem; font-weight: 900; color: #ffffff; margin: 0; line-height: 1.25; letter-spacing: -0.025em;">
        {prediction.title}
      </h1>

      <div style="background: #030712; border: 1px solid rgba(var(--accent-rgb), 0.3); border-radius: 1.25rem; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span style="font-size: 0.7rem; color: #9CA3AF; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Consensus Probability</span>
          <span style="font-size: 2rem; font-weight: 900; color: #ffffff;">{prediction.odds}%</span>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 0.7rem; color: #9CA3AF; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Telemetry Status</span>
          <span style="font-size: 0.85rem; font-weight: 700; color: #34d399;">Active Grid Sync</span>
        </div>
      </div>

      <div style="font-size: 1.05rem; color: #D1D5DB; line-height: 1.8; display: flex; flex-direction: column; gap: 1rem;">
        <p style="margin: 0; color: #ffffff; font-weight: 600;">
          {prediction.summary}
        </p>
        <p style="margin: 0; color: #9CA3AF; font-size: 0.95rem;">
          This prediction is continuously evaluated by the OddsPulse AI Telemetry Engine, tracking cross-market sentiment, on-chain reserves, and public institutional filings in real-time.
        </p>
      </div>

      <!-- Interactive Community Vote Widget -->
      <div style="margin-top: 1.5rem; border-top: 1px solid #1F2937; padding-top: 1.5rem;">
        <h3 style="font-size: 0.9rem; font-weight: 800; color: #ffffff; margin: 0 0 1rem 0;">Cast Community Prediction Vote</h3>
        <div style="display: flex; gap: 1rem;" id="vote-container">
          <button id="vote-yes" style="flex: 1; background: #022c22; color: #34d399; border: 1px solid rgba(52,211,153,0.4); padding: 0.75rem; border-radius: 0.75rem; font-weight: 800; cursor: pointer; font-size: 0.9rem;">YES</button>
          <button id="vote-no" style="flex: 1; background: #4c0519; color: #fb7185; border: 1px solid rgba(225,29,72,0.4); padding: 0.75rem; border-radius: 0.75rem; font-weight: 800; cursor: pointer; font-size: 0.9rem;">NO</button>
        </div>
        <div id="vote-result" style="margin-top: 0.75rem; font-size: 0.8rem; color: #34d399; font-weight: 700; display: none; text-align: center;">
          ✓ Vote recorded successfully to telemetry ledger!
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ slug: prediction.slug }}>
    const yesBtn = document.getElementById('vote-yes');
    const noBtn = document.getElementById('vote-no');
    const resultEl = document.getElementById('vote-result');

    function handleVote(choice) {
      localStorage.setItem(`voted_${slug}`, choice);
      if (yesBtn && noBtn && resultEl) {
        yesBtn.style.opacity = '0.5';
        noBtn.style.opacity = '0.5';
        yesBtn.setAttribute('disabled', 'true');
        noBtn.setAttribute('disabled', 'true');
        resultEl.style.display = 'block';
      }
    }

    yesBtn?.addEventListener('click', () => handleVote('YES'));
    noBtn?.addEventListener('click', () => handleVote('NO'));

    if (localStorage.getItem(`voted_${slug}`)) {
      if (yesBtn && noBtn && resultEl) {
        yesBtn.setAttribute('disabled', 'true');
        noBtn.setAttribute('disabled', 'true');
        yesBtn.style.opacity = '0.5';
        noBtn.style.opacity = '0.5';
        resultEl.textContent = `✓ You already voted: ${localStorage.getItem(`voted_${slug}`)}`;
        resultEl.style.display = 'block';
      }
    }
  </script>
</Layout>
