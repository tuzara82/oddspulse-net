---
import Layout from '../../layouts/Layout.astro';
import predictions from '../../data/predictions.json';

export async function getStaticPaths() {
  return predictions.map((item) => ({
    params: { slug: item.slug },
    props: { prediction: item },
  }));
}

const { prediction } = Astro.props;

const getNeonColor = (value: number) => {
  if (value > 70) return 'text-emerald-400 border-emerald-500/40 bg-emerald-950/30 shadow-[0_0_20px_rgba(52,211,153,0.15)]';
  if (value >= 40) return 'text-cyan-400 border-cyan-500/40 bg-cyan-950/30 shadow-[0_0_20px_rgba(6,182,212,0.15)]';
  return 'text-rose-400 border-rose-500/40 bg-rose-950/30 shadow-[0_0_20px_rgba(244,63,94,0.15)]';
};
---

<Layout title={prediction.title}>
  <!-- Back Button -->
  <div class="mb-6">
    <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-gray-400 hover:text-cyan-400 transition-colors bg-[#161E2E] px-4 py-2 rounded-xl border border-gray-800">
      &larr; Back to Markets Feed
    </a>
  </div>

  <!-- Main Detail Card -->
  <div class="p-8 rounded-2xl border border-gray-800/80 bg-gradient-to-br from-[#131B2E] to-[#0D1322] shadow-2xl relative overflow-hidden mb-8">
    <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/5 blur-3xl -z-10 rounded-full pointer-events-none"></div>

    <!-- Category & Trend -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <span class="text-xs px-3 py-1 rounded-md bg-cyan-500/10 text-cyan-400 font-semibold border border-cyan-500/30">
        {prediction.category}
      </span>
      <span class={`text-xs font-semibold px-3 py-1 rounded-md border ${prediction.trendUp ? 'bg-emerald-950/40 text-emerald-400 border-emerald-500/30' : 'bg-rose-950/40 text-rose-400 border-rose-500/30'}`}>
        {prediction.trend}
      </span>
    </div>

    <!-- Title -->
    <h1 class="text-2xl md:text-3xl font-extrabold text-gray-100 mb-6 leading-snug">
      {prediction.title}
    </h1>

    <!-- Probability & Metric Banner -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-6 rounded-xl bg-[#0B0F19]/60 border border-gray-800 mb-8 items-center">
      <div class="md:col-span-2">
        <div class="text-xs uppercase tracking-wider text-gray-500 font-semibold mb-1">Telemetry Status</div>
        <div class="text-sm text-gray-300">Continuous multi-model aggregation reflecting real-time market sentiment and technical milestones.</div>
      </div>
      <div class="flex flex-col items-center md:items-end">
        <div class="text-[10px] text-gray-500 uppercase tracking-wider font-semibold mb-1">Current Probability</div>
        <div class={`text-3xl font-black px-6 py-3 rounded-xl border flex items-center justify-center ${getNeonColor(prediction.odds)}`}>
          {prediction.odds}%
        </div>
      </div>
    </div>

    <!-- Core Summary -->
    <div class="mb-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-400 mb-3">Executive Summary</h2>
      <p class="text-gray-300 text-base leading-relaxed">
        {prediction.summary}
      </p>
    </div>

    <!-- Key Drivers / Analytical Breakdown -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-gray-800/80">
      <div class="p-5 rounded-xl bg-[#0B0F19]/40 border border-gray-800/60">
        <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Upward Catalysts
        </h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Accelerated capital deployment, growing regulatory alignment, and higher-than-expected hardware scaling velocities support upward probability revisions.
        </p>
      </div>

      <div class="p-5 rounded-xl bg-[#0B0F19]/40 border border-gray-800/60">
        <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-rose-400"></span> Downside Risks
        </h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Potential supply chain bottlenecks, macroeconomic headwinds, and complex compliance frameworks introduce friction that could delay milestones.
        </p>
      </div>
    </div>

  </div>
</Layout>
