---
import Layout from '../../layouts/Layout.astro';
import predictions from '../../data/predictions.json';

export async function getStaticPaths() {
  return predictions.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

const getNeonColor = (value: number) => {
  if (value > 70) return 'text-emerald-400 border-emerald-500/40 bg-emerald-950/35 shadow-[0_0_20px_rgba(52,211,153,0.15)]';
  if (value >= 40) return 'text-cyan-400 border-cyan-500/40 bg-cyan-950/35 shadow-[0_0_20px_rgba(6,182,212,0.15)]';
  return 'text-rose-400 border-rose-500/40 bg-rose-950/35 shadow-[0_0_20px_rgba(244,63,94,0.15)]';
};
---

<Layout 
  title={item.title} 
  description={item.summary}
  canonicalURL={`https://oddspulse.net/predictions/${item.slug}`}
>
  <div class="mb-6">
    <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors bg-cyan-950/40 px-3 py-1.5 rounded-lg border border-cyan-500/30">
      ← Back to Markets Feed
    </a>
  </div>

  <!-- Main Article / Prediction Card -->
  <article class="p-8 rounded-3xl border border-gray-800/90 bg-gradient-to-br from-[#131B2E] to-[#0D1322] shadow-2xl relative overflow-hidden">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-cyan-500/5 blur-3xl rounded-full pointer-events-none"></div>

    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div class="flex items-center gap-3">
        <span class="text-xs px-3 py-1 rounded-md bg-gray-800/90 text-cyan-400 font-semibold border border-gray-700/60 uppercase tracking-wider">
          {item.category}
        </span>
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-md ${item.trendUp ? 'text-emerald-400 bg-emerald-950/50' : 'text-rose-400 bg-rose-950/50'}`}>
          {item.trend}
        </span>
      </div>
      <div class="text-xs text-gray-400">
        Telemetry Update: <span class="text-gray-200 font-medium">Real-time</span>
      </div>
    </div>

    <h1 class="text-2xl md:text-3xl font-extrabold text-white mb-6 leading-snug">
      {item.title}
    </h1>

    <!-- Core Probability Metric Box -->
    <div class="flex items-center justify-between p-6 rounded-2xl bg-[#090E17] border border-gray-800 mb-8">
      <div>
        <span class="text-xs text-gray-400 uppercase tracking-widest block mb-1 font-medium">Current AI Consensus</span>
        <span class="text-sm text-gray-300">Probabilistic Likelihood Assessment</span>
      </div>
      <div class={`text-3xl md:text-4xl font-black px-6 py-3 rounded-xl border flex items-center justify-center ${getNeonColor(item.odds)}`}>
        {item.odds}%
      </div>
    </div>

    <!-- Summary / Overview -->
    <div class="space-y-4 mb-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-400">Executive Summary</h2>
      <p class="text-gray-300 text-base leading-relaxed font-normal">
        {item.summary}
      </p>
    </div>

    <!-- Catalysts & Risks Grid -->
    <div class="grid md:grid-cols-2 gap-6 pt-6 border-t border-gray-800/80">
      <div class="p-5 rounded-2xl bg-[#0B101B] border border-emerald-500/20">
        <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-3 flex items-center gap-2">
          <span>📈</span> Upward Catalysts
        </h3>
        <ul class="space-y-2 text-sm text-gray-400 list-disc list-inside">
          <li>Accelerated R&D funding and private capital inflows.</li>
          <li>Favorable regulatory shifts and geopolitical incentives.</li>
          <li>Breakthrough scaling milestones achieved ahead of schedule.</li>
        </ul>
      </div>

      <div class="p-5 rounded-2xl bg-[#0B101B] border border-rose-500/20">
        <h3 class="text-xs font-bold uppercase tracking-wider text-rose-400 mb-3 flex items-center gap-2">
          <span>📉</span> Downside Risks
        </h3>
        <ul class="space-y-2 text-sm text-gray-400 list-disc list-inside">
          <li>Unforeseen systemic bottlenecks and technical roadblocks.</li>
          <li>Strict governmental compliance barriers or moratoriums.</li>
          <li>Supply chain constraints impacting critical hardware/infrastructure.</li>
        </ul>
      </div>
    </div>
  </article>
</Layout>
