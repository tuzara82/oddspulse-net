---
import Layout from '../layouts/Layout.astro';
import predictions from '../data/predictions.json';

const getNeonColor = (value: number) => {
  if (value > 70) return 'text-emerald-400 border-emerald-500/40 bg-emerald-950/30 shadow-[0_0_15px_rgba(52,211,153,0.15)]';
  if (value >= 40) return 'text-cyan-400 border-cyan-500/40 bg-cyan-950/30 shadow-[0_0_15px_rgba(6,182,212,0.15)]';
  return 'text-rose-400 border-rose-500/40 bg-rose-950/30 shadow-[0_0_15px_rgba(244,63,94,0.15)]';
};

// Функция за генериране на SVG точки за sparkline графиката
const generateSparklinePoints = (history: number[] = []) => {
  if (!history || history.length < 2) return "0,15 100,15";
  const min = Math.min(...history);
  const max = Math.max(...history);
  const range = max - min || 1;
  const width = 100;
  const height = 30;

  return history
    .map((val, idx) => {
      const x = (idx / (history.length - 1)) * width;
      const y = height - ((val - min) / range) * (height - 6) - 3;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
};

const categories = ['All', ...new Set(predictions.map((item) => item.category))];
---

<Layout title="Global Odds Thermometer">
  <!-- Hero Section -->
  <div class="mb-10 text-center relative">
    <div class="absolute inset-0 -top-10 bg-gradient-to-r from-cyan-500/10 via-purple-500/10 to-blue-500/10 blur-3xl -z-10 rounded-full"></div>
    <span class="text-xs uppercase tracking-widest px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-semibold mb-4 inline-block">
      Live Intelligence Feed
    </span>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 bg-gradient-to-r from-white via-gray-200 to-gray-400 bg-clip-text text-transparent">
      Global Odds Thermometer
    </h1>
    <p class="text-gray-400 max-w-xl mx-auto text-base">
      Real-time probabilistic forecasts for major tech breakthroughs, economic shifts, and global events, driven by autonomous AI analytics.
    </p>
  </div>

  <!-- Category Filter Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-2 mb-8" id="filter-container">
    {categories.map((cat, index) => (
      <button
        data-category={cat}
        class={`filter-btn text-xs px-3.5 py-2 rounded-xl font-medium transition-all duration-200 border ${
          index === 0
            ? 'bg-cyan-500/20 text-cyan-300 border-cyan-500/50 shadow-[0_0_10px_rgba(6,182,212,0.2)]'
            : 'bg-[#161E2E] text-gray-400 border-gray-800 hover:border-gray-700 hover:text-white'
        }`}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Predictions Grid / List -->
  <div class="grid gap-4" id="predictions-grid">
    {predictions.map((item) => (
      <a
        href={`/predictions/${item.slug}`}
        data-category={item.category}
        class="prediction-card block p-6 rounded-2xl border border-gray-800/80 bg-gradient-to-br from-[#131B2E] to-[#0D1322] hover:border-cyan-500/50 transition-all duration-300 group shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
      >
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2 flex-grow">
            <div class="flex items-center gap-3">
              <span class="text-xs px-2.5 py-1 rounded-md bg-gray-800/80 text-cyan-400 font-medium border border-gray-700/50">
                {item.category}
              </span>
              <span class={`text-xs font-semibold ${item.trendUp ? 'text-emerald-400' : 'text-rose-400'}`}>
                {item.trend}
              </span>
            </div>
            <h2 class="text-lg md:text-xl font-bold text-gray-100 group-hover:text-cyan-300 transition-colors">
              {item.title}
            </h2>
          </div>

          <!-- Probability Badge & Sparkline -->
          <div class="flex items-center justify-between md:justify-end gap-6 shrink-0">
            <!-- Mini Sparkline Chart -->
            <div class="hidden sm:flex flex-col items-center">
              <span class="text-[9px] text-gray-500 uppercase tracking-wider mb-1 font-semibold">Trend History</span>
              <svg class="w-24 h-7 overflow-visible" viewBox="0 0 100 30">
                <polyline
                  fill="none"
                  stroke={item.trendUp ? "#34d399" : "#f43f5e"}
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  points={generateSparklinePoints(item.history)}
                />
              </svg>
            </div>

            <div class="text-right hidden md:block">
              <div class="text-[10px] text-gray-500 uppercase tracking-wider font-semibold">Probability</div>
              <div class="text-xs text-gray-400">AI Consensus</div>
            </div>
            <div class={`text-2xl font-black px-5 py-2.5 rounded-xl border flex items-center justify-center min-w-[90px] ${getNeonColor(item.odds)}`}>
              {item.odds}%
            </div>
          </div>
        </div>
        <p class="text-sm text-gray-400 mt-4 line-clamp-2 font-normal">
          {item.summary}
        </p>
      </a>
    ))}
  </div>

  <!-- Client-side Filtering Script -->
  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.prediction-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.className = 'filter-btn text-xs px-3.5 py-2 rounded-xl font-medium transition-all duration-200 border bg-[#161E2E] text-gray-400 border-gray-800 hover:border-gray-700 hover:text-white';
        });
        btn.className = 'filter-btn text-xs px-3.5 py-2 rounded-xl font-medium transition-all duration-200 border bg-cyan-500/20 text-cyan-300 border-cyan-500/50 shadow-[0_0_10px_rgba(6,182,212,0.2)]';

        const selectedCategory = btn.getAttribute('data-category');

        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (selectedCategory === 'All' || cardCategory === selectedCategory) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
