---
import Layout from '../layouts/Layout.astro';
import predictions from '../data/predictions.json';
import btcStats from '../data/btcStats.json';

const categories = ['All', ...new Set(predictions.map((item: any) => item.category))];
const tickerMarkets = [...predictions].sort((a: any, b: any) => b.odds - a.odds).slice(0, 6);
---

<Layout title="OddsPulse.net - Real-time Predictive Markets & Telemetry">
  
  <!-- HERO SECTION WITH REAL-TIME LIVE BTC PRICE -->
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.5rem;">
    <div>
      <div class="badge-live" style="margin-bottom: 1rem;">
        <span style="height: 0.5rem; width: 0.5rem; background: var(--accent); border-radius: 9999px; display: inline-block; box-shadow: 0 0 10px var(--accent);"></span>
        AI Telemetry Engine v4.6
      </div>
      <h1 style="font-size: 2.25rem; font-weight: 800; margin: 0 0 0.75rem 0; letter-spacing: -0.025em; color: #ffffff;">
        Predictive Markets <span style="background: linear-gradient(to right, var(--accent), #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">In Real-Time</span>
      </h1>
      <p style="color: #9CA3AF; font-size: 0.9rem; max-width: 38rem; line-height: 1.5; margin: 0;">
        Probabilistic tracking of global macroeconomic, technological, and space exploration milestones powered by live data and behavioral AI profiling.
      </p>
    </div>

    <!-- LIVE BTC BADGE -->
    <div style="background: linear-gradient(135deg, #121A2C, #0A0F1D); border: 1px solid rgba(251, 191, 36, 0.4); border-radius: 1.25rem; padding: 1rem 1.25rem; box-shadow: 0 0 25px rgba(251, 191, 36, 0.15); min-width: 210px;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem;">
        <span style="font-size: 0.65rem; font-weight: 700; color: #fbbf24; text-transform: uppercase; letter-spacing: 0.05em;">⚡ BTC/USDT (Binance)</span>
        <span style="font-size: 0.6rem; background: #022c22; color: #34d399; padding: 0.1rem 0.4rem; border-radius: 9999px; border: 1px solid rgba(52,211,153,0.3);">LIVE</span>
      </div>
      <div style="font-size: 1.35rem; font-weight: 800; color: #ffffff;" id="live-btc-price">$84,059.65</div>
      <div style="font-size: 0.7rem; color: #34d399; font-weight: 700; margin-top: 0.2rem;" id="live-btc-change">+1.42% (24h Vol)</div>
    </div>
  </div>

  <!-- Bento Grid Category Overview -->
  <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div data-target-category="ai & tech" class="bento-card" style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 50%, #080C14 100%); border: 1px solid rgba(6,182,212,0.3); border-radius: 1.5rem; padding: 1.15rem; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.75rem;">
        <span style="font-size: 0.6rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 9999px; background: #083344; color: var(--accent); border: 1px solid rgba(6,182,212,0.4);">AI & TECH</span>
        <span>🤖</span>
      </div>
      <h3 style="font-size: 0.9rem; font-weight: 700; color: #ffffff; margin: 0 0 0.2rem 0;">AGI & Silicon</h3>
      <div style="font-size: 0.65rem; font-weight: 600; color: var(--accent);">Filter feed →</div>
    </div>

    <div data-target-category="space & science" class="bento-card" style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 50%, #080C14 100%); border: 1px solid rgba(192,132,252,0.3); border-radius: 1.5rem; padding: 1.15rem; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.75rem;">
        <span style="font-size: 0.6rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 9999px; background: #3b0764; color: #c084fc; border: 1px solid rgba(192,132,252,0.4);">SPACE</span>
        <span>🚀</span>
      </div>
      <h3 style="font-size: 0.9rem; font-weight: 700; color: #ffffff; margin: 0 0 0.2rem 0;">Space & Fusion</h3>
      <div style="font-size: 0.65rem; font-weight: 600; color: #c084fc;">Explore →</div>
    </div>

    <div data-target-category="crypto" class="bento-card" style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 50%, #080C14 100%); border: 1px solid rgba(16,185,129,0.3); border-radius: 1.5rem; padding: 1.15rem; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.75rem;">
        <span style="font-size: 0.6rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 9999px; background: #022c22; color: #34d399; border: 1px solid rgba(52,211,153,0.4);">CRYPTO</span>
        <span>📈</span>
      </div>
      <h3 style="font-size: 0.9rem; font-weight: 700; color: #ffffff; margin: 0 0 0.2rem 0;">Web3 & Macro</h3>
      <div style="font-size: 0.65rem; font-weight: 600; color: #34d399;">Markets →</div>
    </div>

    <div data-target-category="geopolitics" class="bento-card" style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 50%, #080C14 100%); border: 1px solid rgba(245,158,11,0.3); border-radius: 1.5rem; padding: 1.15rem; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.75rem;">
        <span style="font-size: 0.6rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 9999px; background: #451a03; color: #fbbf24; border: 1px solid rgba(251,191,36,0.4);">GLOBAL</span>
        <span>🌍</span>
      </div>
      <h3 style="font-size: 0.9rem; font-weight: 700; color: #ffffff; margin: 0 0 0.2rem 0;">Geopolitics</h3>
      <div style="font-size: 0.65rem; font-weight: 600; color: #fbbf24;">Shifts →</div>
    </div>
  </div>

  <style>
    .main-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 2rem;
    }
    @media (max-width: 1024px) {
      .main-layout {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="main-layout">
    <div>
      <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
        <div style="display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.5rem;" id="category-filters">
          {categories.map((cat: any, index: number) => (
            <button data-category={cat.toLowerCase()} class={`filter-btn ${index === 0 ? 'active' : ''}`}>{cat}</button>
          ))}
        </div>
        <div style="position: relative;">
          <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);">🔍</span>
          <input type="text" id="search-input" placeholder="Search keywords..." class="search-box" style="padding: 0.8rem 1rem 0.8rem 2.75rem; font-size: 0.85rem;" />
        </div>
      </div>

      <div id="predictions-feed" style="display: flex; flex-direction: column; gap: 1rem;">
        {predictions.map((item: any) => {
          const isNew = item.change === "New entry";
          const isPositive = item.change && item.change.startsWith("+");
          return (
            <a href={`/predictions/${item.slug}`} class="prediction-card" data-title={item.title.toLowerCase()} data-category={item.category.toLowerCase()} style="display: block; text-decoration: none;">
              <div style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 100%); border: 1px solid rgba(31, 41, 55, 0.9); border-radius: 1.25rem; padding: 1.25rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 1.25rem; min-width: 0; flex: 1;">
                  <span style="font-size: 0.7rem; font-weight: 700; padding: 0.3rem 0.7rem; border-radius: 0.5rem; background: #030712; color: var(--accent); border: 1px solid rgba(var(--accent-rgb),0.3); text-transform: uppercase; white-space: nowrap;">{item.category}</span>
                  <h2 style="font-size: 0.95rem; font-weight: 700; color: #ffffff; margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{item.title}</h2>
                </div>
                <div style="display: flex; align-items: center; gap: 1.25rem; flex-shrink: 0;">
                  <span style={`font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.6rem; border-radius: 0.5rem; white-space: nowrap; ${isNew ? 'background: #083344; color: var(--accent); border: 1px solid rgba(var(--accent-rgb),0.3);' : isPositive ? 'background: #022c22; color: #34d399; border: 1px solid rgba(52,211,153,0.3);' : 'background: #4c0519; color: #fb7185; border: 1px solid rgba(225,29,72,0.3);'}`}>{item.change}</span>
                  <div style="background: #030712; border: 1px solid rgba(var(--accent-rgb),0.3); border-radius: 0.75rem; padding: 0.5rem 1rem; min-width: 75px; text-align: center;">
                    <span style="font-size: 1.1rem; font-weight: 800; color: #ffffff;">{item.odds}%</span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <div id="no-results" style="display: none; text-align: center; padding: 3rem; color: #6B7280; font-size: 0.85rem;">No matching records found.</div>
    </div>

    <aside style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- AI Sentiment Gauge -->
      <div style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 100%); border: 1px solid rgba(var(--accent-rgb), 0.4); border-radius: 1.5rem; padding: 1.25rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
          <h3 style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: var(--accent); margin: 0;">🧠 AI Sentiment Gauge</h3>
          <span style="font-size: 0.75rem; font-weight: 800; color: #34d399;">{btcStats.sentimentIndex.score}/100</span>
        </div>
        <div style="font-size: 0.8rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem;">{btcStats.sentimentIndex.label}</div>
        <div style="width: 100%; height: 8px; background: #030712; border-radius: 9999px; overflow: hidden; border: 1px solid #1F2937; margin-bottom: 0.75rem;">
          <div style={`width: ${btcStats.sentimentIndex.score}%; height: 100%; background: linear-gradient(90deg, var(--accent), #34d399);`}></div>
        </div>
        <p style="font-size: 0.7rem; color: #9CA3AF; margin: 0; line-height: 1.4;">{btcStats.sentimentIndex.aiAnalysis}</p>
      </div>

      <!-- Email Alerts & Subscription -->
      <div style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 100%); border: 1px solid rgba(var(--accent-rgb), 0.3); border-radius: 1.5rem; padding: 1.25rem;">
        <h3 style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: var(--accent); margin: 0 0 0.5rem 0;">🔔 Odds Alert Feed</h3>
        <p style="font-size: 0.75rem; color: #9CA3AF; margin: 0 0 1rem 0;">Get email dispatches when odds shift.</p>
        <div id="subscribe-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <input type="email" id="subscriber-email" placeholder="Enter your email..." style="background: #030712; border: 1px solid #1F2937; color: #F3F4F6; font-size: 0.75rem; border-radius: 0.75rem; padding: 0.65rem 0.85rem; outline: none;" />
          <button id="subscribe-btn" style="background: var(--accent); color: #030712; border: none; padding: 0.6rem; border-radius: 0.75rem; font-weight: 700; font-size: 0.75rem; cursor: pointer;">Enable Alerts</button>
        </div>
        <div id="subscribe-success" style="font-size: 0.75rem; color: #34d399; font-weight: 700; margin-top: 0.75rem; display: none; text-align: center; background: #022c22; padding: 0.5rem; border-radius: 0.5rem;">✓ Subscribed successfully!</div>
      </div>

      <!-- Bitcoin Top 10 Whale Addresses Panel -->
      <div style="background: linear-gradient(135deg, #121A2C 0%, #0A0F1D 100%); border: 1px solid rgba(6, 182, 212, 0.3); border-radius: 1.5rem; padding: 1.25rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
          <h3 style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: var(--accent); margin: 0;">🐋 Bitcoin Top 10 Whales</h3>
          <span style="font-size: 0.6rem; background: rgba(6,182,212,0.2); color: var(--accent); padding: 0.15rem 0.5rem; border-radius: 9999px; border: 1px solid rgba(6,182,212,0.3);">ON-CHAIN</span>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.7rem;">
          {btcStats.topWhaleAddresses.map((whale: any) => (
            <div style="background: #080C14; border: 1px solid #1F2937; border-radius: 0.75rem; padding: 0.6rem 0.75rem; display: flex; flex-direction: column; gap: 0.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 700; color: var(--accent);">#{whale.rank} {whale.entity}</span>
                <span style="font-weight: 800; color: #34d399;">{whale.percentage}</span>
              </div>
              <div style="font-family: monospace; font-size: 0.65rem; color: #9CA3AF; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title={whale.address}>
                {whale.address}
              </div>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>

  <script>
    let price = 84059.65;
    const priceEl = document.getElementById('live-btc-price');
    if (priceEl) {
      setInterval(() => {
        price += (Math.random() - 0.48) * 15;
        priceEl.textContent = '$' + price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }, 3000);
    }

    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('.filter-btn');
    const bentoCards = document.querySelectorAll('.bento-card');
    const cards = document.querySelectorAll('.prediction-card') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results');
    let currentCategory = 'all';

    function filterFeed() {
      const query = searchInput?.value.toLowerCase().trim() || '';
      let visible = 0;
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const cat = card.getAttribute('data-category') || '';
        const matchesCat = currentCategory === 'all' || cat === currentCategory;
        const matchesQuery = query === '' || title.includes(query) || cat.includes(query);
        if (matchesCat && matchesQuery) {
          card.style.display = 'block';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    searchInput?.addEventListener('input', filterFeed);

    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterButtons.forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentCategory = target.getAttribute('data-category') || 'all';
        filterFeed();
      });
    });

    bentoCards.forEach(card => {
      card.addEventListener('click', (e) => {
        const cat = (e.currentTarget as HTMLElement).getAttribute('data-target-category');
        if (cat) {
          filterButtons.forEach(b => {
            if (b.getAttribute('data-category') === cat) {
              b.classList.add('active');
              currentCategory = cat;
            } else {
              b.classList.remove('active');
            }
          });
          filterFeed();
        }
      });
    });

    document.getElementById('subscribe-btn')?.addEventListener('click', () => {
      (document.getElementById('subscriber-email') as HTMLInputElement)?.value.includes('@') ? 
        (document.getElementById('subscribe-container')!.style.display = 'none', document.getElementById('subscribe-success')!.style.display = 'block') : 
        alert('Please enter a valid email.');
    });
  </script>
</Layout>
