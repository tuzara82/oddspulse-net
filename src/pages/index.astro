---
import Layout from '../layouts/Layout.astro';
import predictions from '../data/predictions.json';
import trades from '../data/trades.json';
import posts from '../data/posts.json';

const topPredictions = predictions.slice(0, 6);
const recentTrades = trades.slice(0, 5);
const latestPosts = posts.slice(0, 3);
---

<Layout title="OddsPulse.net | Predictive Fintech & Web3 Terminal">
  <!-- HERO TELEMETRY TICKER -->
  <div class="bento-card" style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1.5rem; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -50px; right: -50px; width: 200px; height: 200px; background: rgba(var(--accent-rgb), 0.08); border-radius: 50%; filter: blur(40px); pointer-events: none;"></div>
    
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="display: inline-block; width: 10px; height: 10px; background-color: #34d399; border-radius: 50%; box-shadow: 0 0 12px #34d399; animation: pulse 2s infinite;"></span>
        <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #9CA3AF; font-weight: 700;">Live Binance Telemetry Stream</span>
      </div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <span style="font-size: 0.7rem; background: rgba(var(--accent-rgb), 0.15); color: var(--accent); padding: 0.25rem 0.75rem; border-radius: 9999px; border: 1px solid rgba(var(--accent-rgb), 0.3); font-weight: 700;">System One Active</span>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h1 style="font-size: 2.75rem; font-weight: 900; letter-spacing: -0.03em; color: #ffffff; margin: 0 0 0.5rem 0; line-height: 1.1;">
          BTC/USDT <span id="hero-btc-price" style="color: var(--accent);">$--,--</span>
        </h1>
        <p style="margin: 0; color: #9CA3AF; font-size: 0.95rem; max-width: 600px; line-height: 1.5;">
          Autonomous probability prediction markets and decentralized telemetry terminal powered by multi-agent consensus.
        </p>
      </div>

      <!-- MINI TRADING SPARKLINE CHART -->
      <div style="background: rgba(3, 7, 18, 0.6); border: 1px solid rgba(var(--accent-rgb), 0.2); border-radius: 1rem; padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.25rem; min-width: 220px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 0.65rem; color: #9CA3AF; text-transform: uppercase; font-weight: 700;">24h Trend Sparkline</span>
          <span id="btc-change-badge" style="font-size: 0.7rem; font-weight: 800; color: #34d399;">+3.48%</span>
        </div>
        <svg id="sparkline-chart" viewBox="0 0 200 45" style="width: 100%; height: 40px; overflow: visible;">
          <defs>
            <linearGradient id="sparkline-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"></stop>
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.0"></stop>
            </linearGradient>
          </defs>
          <path id="sparkline-area" d="M0,35 Q30,20 60,28 T120,15 T180,8 L200,5 L200,45 L0,45 Z" fill="url(#sparkline-grad)"></path>
          <path id="sparkline-line" d="M0,35 Q30,20 60,28 T120,15 T180,8 L200,5" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- BENTO GRID SECTION -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Predictions Feed -->
    <div class="bento-card" style="grid-column: span 2; display: flex; flex-direction: column; gap: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
          🎯 Active Prediction Markets
        </h2>
        <span style="font-size: 0.75rem; color: #9CA3AF;">Live Telemetry Index</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {topPredictions.map((item) => (
          <a href={`/predictions/${item.slug}`} style="text-decoration: none; color: inherit; display: block;">
            <div style="background: rgba(3, 7, 18, 0.4); border: 1px solid #1F2937; border-radius: 1rem; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease; gap: 1rem;" class="prediction-row">
              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <span style="font-size: 0.65rem; color: var(--accent); font-weight: 700; text-transform: uppercase;">{item.category}</span>
                <span style="font-size: 0.95rem; font-weight: 700; color: #ffffff; line-height: 1.3;">{item.title}</span>
              </div>
              <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; min-width: 80px;">
                <span style="font-size: 1.1rem; font-weight: 900; color: #ffffff;">{item.odds}%</span>
                <span style="font-size: 0.7rem; font-weight: 700; color: #34d399;">{item.change}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Recent Autonomous Trades -->
    <div class="bento-card" style="display: flex; flex-direction: column; gap: 1.25rem;">
      <h2 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        🤖 Jev Autonomous Trades
      </h2>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {recentTrades.map((trade) => (
          <div style="background: rgba(3, 7, 18, 0.4); border: 1px solid #1F2937; border-radius: 1rem; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.7rem; font-weight: 800; padding: 0.15rem 0.5rem; border-radius: 0.3rem; background: {trade.outcome === 'YES' ? '#022c22' : '#4c0519'}; color: {trade.outcome === 'YES' ? '#34d399' : '#fb7185'};">
                {trade.outcome} (${trade.sizeUsdc})
              </span>
              <span style="font-size: 0.7rem; color: #9CA3AF;">{trade.confidence}% Conf</span>
            </div>
            <p style="margin: 0; font-size: 0.85rem; color: #D1D5DB; font-weight: 600; line-height: 1.3;">
              {trade.market}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- RESEARCH BLOG SECTION PREVIEW -->
  <div class="bento-card" style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <h2 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        📚 Research Blog & Dispatches
      </h2>
      <a href="/blog" style="font-size: 0.8rem; color: var(--accent); font-weight: 700; text-decoration: none;">View All Articles →</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.slug}`} style="text-decoration: none; color: inherit; display: flex; flex-direction: column;" class="blog-card-link">
          <div style="background: rgba(3, 7, 18, 0.4); border: 1px solid #1F2937; border-radius: 1rem; overflow: hidden; height: 100%; display: flex; flex-direction: column;">
            <img src={post.image} alt={post.title} style="width: 100%; height: 140px; object-fit: cover;" />
            <div style="padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1;">
              <span style="font-size: 0.65rem; color: var(--accent); font-weight: 700; text-transform: uppercase;">{post.category}</span>
              <h3 style="font-size: 1rem; font-weight: 800; color: #ffffff; margin: 0; line-height: 1.3;">{post.title}</h3>
              <p style="font-size: 0.8rem; color: #9CA3AF; margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{post.summary}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <script>
    // Live Binance WebSocket and Sparkline Animation
    const priceEl = document.getElementById('hero-btc-price');
    const lineEl = document.getElementById('sparkline-line');
    const areaEl = document.getElementById('sparkline-area');

    let historyPrices = [64200, 64350, 64280, 64420, 64500, 64390, 64600, 64750, 64680, 64900];

    function updateSparkline() {
      if (!lineEl || !areaEl) return;
      const min = Math.min(...historyPrices);
      const max = Math.max(...historyPrices);
      const range = max - min || 1;

      const points = historyPrices.map((p, i) => {
        const x = (i / (historyPrices.length - 1)) * 200;
        const y = 40 - ((p - min) / range) * 35 - 5;
        return `${x},${y}`;
      });

      const pathD = `M ${points.join(' L ')}`;
      const areaD = `${pathD} L 200,45 L 0,45 Z`;

      lineEl.setAttribute('d', pathD);
      areaEl.setAttribute('d', areaD);
    }

    // Connect to Binance WebSocket for real-time prices
    try {
      const ws = new WebSocket('wss://stream.binance.com:9443/ws/btcusdt@trade');
      ws.onmessage = (event) => {
        const data = JSON.parse(event.data);
        const price = parseFloat(data.p);
        if (priceEl) {
          priceEl.textContent = `$${price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }
        historyPrices.push(price);
        if (historyPrices.length > 15) historyPrices.shift();
        updateSparkline();
      };
    } catch (e) {
      if (priceEl) priceEl.textContent = '$64,900.00';
    }

    updateSparkline();
  </script>

  <style>
    .prediction-row:hover, .blog-card-link:hover {
      border-color: rgba(var(--accent-rgb), 0.5) !important;
      transform: translateY(-2px);
    }
  </style>
</Layout>
