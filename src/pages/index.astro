---
import Layout from '../layouts/Layout.astro';
import predictions from '../data/predictions.json';

// Get unique categories dynamically
const categories = ['All', ...new Set(predictions.map(item => item.category))];
---

<Layout title="OddsPulse.net - Real-time Predictive Markets & Telemetry">
  <div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">Live AI Telemetry Feed</span>
        </div>
        <p class="text-sm text-gray-400">Real-time probabilistic tracking of global macroeconomic, technological, and geopolitical milestones.</p>
      </div>

      <!-- Real-time Search Input -->
      <div class="relative w-full md:w-72">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
          🔍
        </span>
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search markets or keywords..." 
          class="w-full bg-[#0D1322] border border-gray-800 text-gray-200 text-xs rounded-xl pl-9 pr-4 py-2.5 focus:outline-none focus:border-cyan-500 transition-colors shadow-inner placeholder-gray-500"
        />
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="category-filters">
      {categories.map((cat, index) => (
        <button
          data-category={cat.toLowerCase()}
          class={`px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border ${
            index === 0 
              ? 'bg-cyan-500 text-gray-950 border-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)]' 
              : 'bg-[#121A2C] text-gray-300 border-gray-800 hover:border-cyan-500/50 hover:text-white'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Predictions Feed Grid -->
  <div class="space-y-3" id="predictions-feed">
    {predictions.map((item) => {
      const isNew = item.change === "New entry";
      const isPositive = item.change && item.change.startsWith("+");
      
      return (
        <a 
          href={`/predictions/${item.slug}`} 
          class="prediction-card block p-4 rounded-2xl border border-gray-800/80 bg-gradient-to-r from-[#121A2C] to-[#0A0F1D] hover:border-cyan-500/40 hover:shadow-[0_0_20px_rgba(6,182,212,0.1)] transition-all group"
          data-title={item.title.toLowerCase()}
          data-category={item.category.toLowerCase()}
          data-summary={item.summary.toLowerCase()}
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-[10px] font-bold px-2.5 py-1 rounded-md bg-gray-900/80 text-cyan-400 border border-gray-800 uppercase tracking-wider shrink-0">
                {item.category}
              </span>
              <h2 class="text-sm font-semibold text-gray-100 group-hover:text-cyan-300 transition-colors truncate">
                {item.title}
              </h2>
            </div>
            
            <div class="flex items-center gap-4 shrink-0 justify-between md:justify-end">
              <span class={`change-badge text-xs font-medium px-2.5 py-1 rounded-md ${
                isNew 
                  ? 'bg-cyan-950/60 text-cyan-400 border border-cyan-500/30' 
                  : isPositive 
                    ? 'bg-emerald-950/40 text-emerald-400 border border-emerald-500/20' 
                    : 'bg-rose-950/40 text-rose-400 border border-rose-500/20'
              }`}>
                {item.change}
              </span>
              
              <div class="odds-value text-base font-extrabold text-white px-3 py-1 rounded-xl bg-[#080C14] border border-gray-800 min-w-[65px] text-center transition-all duration-300">
                {item.odds}%
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <!-- No Results State -->
  <div id="no-results" class="hidden text-center py-12 text-gray-500 text-sm">
    No matching telemetry records found for your search/filter criteria.
  </div>

  <!-- Client-side Filtering, Search & Live Simulation Script -->
  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('#category-filters button');
    const cards = document.querySelectorAll('.prediction-card') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results');

    let currentCategory = 'all';

    function applyFilters() {
      const query = searchInput?.value.toLowerCase().trim() || '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const summary = card.getAttribute('data-summary') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesQuery = query === '' || title.includes(query) || category.includes(query) || summary.includes(query);

        if (matchesCategory && matchesQuery) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    // Search input listener
    searchInput?.addEventListener('input', applyFilters);

    // Category buttons listener
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        filterButtons.forEach((b) => {
          b.className = 'px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-[#121A2C] text-gray-300 border-gray-800 hover:border-cyan-500/50 hover:text-white';
        });
        
        const target = e.currentTarget as HTMLElement;
        target.className = 'px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-cyan-500 text-gray-950 border-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)]';

        currentCategory = target.getAttribute('data-category') || 'all';
        applyFilters();
      });
    });

    // Live Market Simulation (Fluctuates odds randomly every 4 seconds)
    setInterval(() => {
      if (cards.length === 0) return;
      
      // Pick a random card to update
      const randomIndex = Math.floor(Math.random() * cards.length);
      const card = cards[randomIndex];
      
      const oddsEl = card.querySelector('.odds-value');
      const changeEl = card.querySelector('.change-badge');
      
      if (!oddsEl || !changeEl) return;

      let currentOdds = parseInt(oddsEl.textContent || '50', 10);
      
      // Decide whether to go up or down (+1% or -1%)
      const delta = Math.random() > 0.45 ? 1 : -1;
      let newOdds = currentOdds + delta;
      
      // Keep within realistic bounds (10% to 98%)
      if (newOdds < 10) newOdds = 11;
      if (newOdds > 98) newOdds = 97;

      if (newOdds !== currentOdds) {
        oddsEl.textContent = `${newOdds}%`;
        
        // Brief visual flash effect
        oddsEl.classList.add('text-cyan-400', 'border-cyan-500/60');
        setTimeout(() => {
          oddsEl.classList.remove('text-cyan-400', 'border-cyan-500/60');
        }, 800);

        // Update change label dynamically
        const diff = newOdds - currentOdds;
        const sign = diff > 0 ? `+${diff}%` : `${diff}%`;
        changeEl.textContent = sign;
        
        if (diff > 0) {
          changeEl.className = 'change-badge text-xs font-medium px-2.5 py-1 rounded-md bg-emerald-950/40 text-emerald-400 border border-emerald-500/20';
        } else {
          changeEl.className = 'change-badge text-xs font-medium px-2.5 py-1 rounded-md bg-rose-950/40 text-rose-400 border border-rose-500/20';
        }
      }
    }, 4000);
  </script>
</Layout>
