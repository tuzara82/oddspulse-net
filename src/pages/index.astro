---
import Layout from '../layouts/Layout.astro';
import predictions from '../data/predictions.json';

const categories = ['All', ...new Set(predictions.map(item => item.category))];
const categoryCounts = predictions.reduce((acc: Record<string, number>, item) => {
  acc[item.category] = (acc[item.category] || 0) + 1;
  return acc;
}, {});

const trendingMarkets = [...predictions].sort((a, b) => b.odds - a.odds).slice(0, 3);
---

<Layout title="OddsPulse.net - Real-time Predictive Markets & Telemetry">
  <!-- Hero Section -->
  <div class="mb-8 text-center md:text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold uppercase tracking-widest mb-4 shadow-[0_0_20px_rgba(6,182,212,0.15)]">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
      </span>
      Live AI Telemetry Engine v2.6
    </div>
    <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-3">
      Predictive Markets <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400">In Real-Time</span>
    </h1>
    <p class="text-sm md:text-base text-gray-400 max-w-2xl">
      Probabilistic tracking of global macroeconomic, technological, and geopolitical milestones powered by live data and community sentiment.
    </p>
  </div>

  <!-- Bento Grid Category Overview -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div 
      data-target-category="ai & tech" 
      class="bento-card cursor-pointer md:col-span-2 p-6 rounded-3xl border border-gray-800 bg-gradient-to-br from-[#121A2C] via-[#0A0F1D] to-[#080C14] relative overflow-hidden group hover:border-cyan-500/60 hover:shadow-[0_0_25px_rgba(6,182,212,0.15)] transition-all"
    >
      <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-cyan-500/10 rounded-full blur-3xl group-hover:bg-cyan-500/20 transition-all"></div>
      <div class="flex justify-between items-start mb-6">
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-500/30">AI & TECH</span>
        <span class="text-2xl">🤖</span>
      </div>
      <h3 class="text-lg font-bold text-white mb-2">Artificial Intelligence & AGI Milestones</h3>
      <p class="text-xs text-gray-400 mb-4">Tracking model releases, compute infrastructure, and autonomous agent capabilities.</p>
      <div class="flex items-center justify-between text-xs font-semibold text-cyan-400">
        <span>{categoryCounts['AI & Tech'] || 0} active markets</span>
        <span class="group-hover:translate-x-1 transition-transform">Filter feed →</span>
      </div>
    </div>

    <div 
      data-target-category="crypto" 
      class="bento-card cursor-pointer p-6 rounded-3xl border border-gray-800 bg-gradient-to-br from-[#121A2C] via-[#0A0F1D] to-[#080C14] relative overflow-hidden group hover:border-emerald-500/60 hover:shadow-[0_0_25px_rgba(16,185,129,0.15)] transition-all"
    >
      <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/20 transition-all"></div>
      <div class="flex justify-between items-start mb-6">
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-500/30">CRYPTO</span>
        <span class="text-2xl">📈</span>
      </div>
      <h3 class="text-base font-bold text-white mb-1">Web3 & Macro</h3>
      <p class="text-xs text-gray-400 mb-4">Halvings, ETF flows & adoption.</p>
      <div class="text-xs font-semibold text-emerald-400 group-hover:translate-x-1 transition-transform inline-block">
        {categoryCounts['Crypto'] || 0} markets →
      </div>
    </div>

    <div 
      data-target-category="geopolitics" 
      class="bento-card cursor-pointer p-6 rounded-3xl border border-gray-800 bg-gradient-to-br from-[#121A2C] via-[#0A0F1D] to-[#080C14] relative overflow-hidden group hover:border-amber-500/60 hover:shadow-[0_0_25px_rgba(245,158,11,0.15)] transition-all"
    >
      <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-amber-500/10 rounded-full blur-3xl group-hover:bg-amber-500/20 transition-all"></div>
      <div class="flex justify-between items-start mb-6">
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-950 text-amber-400 border border-amber-500/30">GEOPOLITICS</span>
        <span class="text-2xl">🌍</span>
      </div>
      <h3 class="text-base font-bold text-white mb-1">Global Shifts</h3>
      <p class="text-xs text-gray-400 mb-4">Trade, policy & conflicts.</p>
      <div class="text-xs font-semibold text-amber-400 group-hover:translate-x-1 transition-transform inline-block">
        {categoryCounts['Geopolitics'] || 0} markets →
      </div>
    </div>
  </div>

  <!-- Trending / Hot Markets Ticker Section -->
  <div class="mb-8 p-4 rounded-3xl border border-cyan-500/20 bg-gradient-to-r from-cyan-950/20 via-[#121A2C] to-[#0A0F1D] shadow-lg">
    <div class="flex items-center gap-2 mb-3 px-2">
      <span class="text-cyan-400 text-sm">🔥</span>
      <h2 class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">Trending Hot Markets</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {trendingMarkets.map((item) => (
        <a 
          href={`/predictions/${item.slug}`} 
          class="p-3 rounded-2xl bg-[#080C14]/80 border border-gray-800/80 hover:border-cyan-500/50 transition-all group flex flex-col justify-between"
        >
          <div class="text-xs font-semibold text-gray-200 group-hover:text-cyan-300 transition-colors line-clamp-2 mb-3">
            {item.title}
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-gray-400">{item.category}</span>
            <span class="font-extrabold text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded-lg border border-cyan-500/30">{item.odds}% Prob</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="category-filters">
      {categories.map((cat, index) => (
        <button
          data-category={cat.toLowerCase()}
          class={`filter-pill px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border ${
            index === 0 
              ? 'bg-cyan-500 text-gray-950 border-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)]' 
              : 'bg-[#121A2C] text-gray-300 border-gray-800 hover:border-cyan-500/50 hover:text-white'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="relative w-full md:w-72">
      <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
        🔍
      </span>
      <input 
        type="text" 
        id="search-input" 
        placeholder="Search keywords..." 
        class="w-full bg-[#0D1322] border border-gray-800 text-gray-200 text-xs rounded-xl pl-9 pr-4 py-2.5 focus:outline-none focus:border-cyan-500 transition-colors shadow-inner placeholder-gray-500"
      />
    </div>
  </div>

  <!-- Predictions Feed Grid -->
  <div class="space-y-3" id="predictions-feed">
    {predictions.map((item) => {
      const isNew = item.change === "New entry";
      const isPositive = item.change && item.change.startsWith("+");
      
      return (
        <a 
          href={`/predictions/${item.slug}`} 
          class="prediction-card block p-4 rounded-2xl border border-gray-800/80 bg-gradient-to-r from-[#121A2C] to-[#0A0F1D] hover:border-cyan-500/40 hover:shadow-[0_0_20px_rgba(6,182,212,0.1)] transition-all group"
          data-title={item.title.toLowerCase()}
          data-category={item.category.toLowerCase()}
          data-summary={item.summary.toLowerCase()}
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-[10px] font-bold px-2.5 py-1 rounded-md bg-gray-900/80 text-cyan-400 border border-gray-800 uppercase tracking-wider shrink-0">
                {item.category}
              </span>
              <h2 class="text-sm font-semibold text-gray-100 group-hover:text-cyan-300 transition-colors truncate">
                {item.title}
              </h2>
            </div>
            
            <div class="flex items-center gap-4 shrink-0 justify-between md:justify-end">
              <span class={`change-badge text-xs font-medium px-2.5 py-1 rounded-md ${
                isNew 
                  ? 'bg-cyan-950/60 text-cyan-400 border border-cyan-500/30' 
                  : isPositive 
                    ? 'bg-emerald-950/40 text-emerald-400 border border-emerald-500/20' 
                    : 'bg-rose-950/40 text-rose-400 border border-rose-500/20'
              }`}>
                {item.change}
              </span>
              
              <!-- NumberFlow style animated odds container -->
              <div class="odds-container overflow-hidden relative h-8 px-3 rounded-xl bg-[#080C14] border border-gray-800 min-w-[65px] flex items-center justify-center">
                <span class="odds-value text-base font-extrabold text-white transition-transform duration-300 inline-block">
                  {item.odds}%
                </span>
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <!-- No Results State -->
  <div id="no-results" class="hidden text-center py-12 text-gray-500 text-sm">
    No matching telemetry records found for your search/filter criteria.
  </div>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('.filter-pill');
    const bentoCards = document.querySelectorAll('.bento-card');
    const cards = document.querySelectorAll('.prediction-card') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results');

    let currentCategory = 'all';

    function applyFilters() {
      const query = searchInput?.value.toLowerCase().trim() || '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const summary = card.getAttribute('data-summary') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesQuery = query === '' || title.includes(query) || category.includes(query) || summary.includes(query);

        if (matchesCategory && matchesQuery) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    function setActiveCategory(cat: string) {
      currentCategory = cat;
      filterButtons.forEach((b) => {
        const btnCat = b.getAttribute('data-category');
        if (btnCat === cat) {
          b.className = 'filter-pill px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-cyan-500 text-gray-950 border-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)]';
        } else {
          b.className = 'filter-pill px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-[#121A2C] text-gray-300 border-gray-800 hover:border-cyan-500/50 hover:text-white';
        }
      });
      applyFilters();
      document.getElementById('predictions-feed')?.scrollIntoView({ behavior: 'smooth' });
    }

    searchInput?.addEventListener('input', applyFilters);

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        setActiveCategory(target.getAttribute('data-category') || 'all');
      });
    });

    bentoCards.forEach((card) => {
      card.addEventListener('click', (e) => {
        const targetCard = e.currentTarget as HTMLElement;
        const targetCat = targetCard.getAttribute('data-target-category');
        if (targetCat) {
          setActiveCategory(targetCat);
        }
      });
    });

    // NumberFlow-style Rolling Simulation Effect
    setInterval(() => {
      if (cards.length === 0) return;
      const randomIndex = Math.floor(Math.random() * cards.length);
      const card = cards[randomIndex];
      
      const oddsEl = card.querySelector('.odds-value') as HTMLElement;
      const changeEl = card.querySelector('.change-badge');
      
      if (!oddsEl || !changeEl) return;

      let currentOdds = parseInt(oddsEl.textContent || '50', 10);
      const delta = Math.random() > 0.45 ? 1 : -1;
      let newOdds = currentOdds + delta;
      
      if (newOdds < 10) newOdds = 11;
      if (newOdds > 98) newOdds = 97;

      if (newOdds !== currentOdds) {
        // Roll-out animation (slide up & fade)
        oddsEl.style.transform = 'translateY(-12px)';
        oddsEl.style.opacity = '0';

        setTimeout(() => {
          oddsEl.textContent = newOdds + '%';
          // Roll-in animation from bottom
          oddsEl.style.transform = 'translateY(12px)';
          
          setTimeout(() => {
            oddsEl.style.transform = 'translateY(0)';
            oddsEl.style.opacity = '1';
          }, 50);
        }, 150);

        const diff = newOdds - currentOdds;
        const sign = diff > 0 ? `+${diff}%` : `${diff}%`;
        changeEl.textContent = sign;
        
        if (diff > 0) {
          changeEl.className = 'change-badge text-xs font-medium px-2.5 py-1 rounded-md bg-emerald-950/40 text-emerald-400 border border-emerald-500/20';
        } else {
          changeEl.className = 'change-badge text-xs font-medium px-2.5 py-1 rounded-md bg-rose-950/40 text-rose-400 border border-rose-500/20';
        }
      }
    }, 4000);
  </script>
</Layout>
