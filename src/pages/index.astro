---
import Layout from '../layouts/Layout.astro';
import predictions from '../data/predictions.json';

const getNeonColor = (value: number) => {
  if (value > 70) return 'text-emerald-400 border-emerald-500/40 bg-emerald-950/30 shadow-[0_0_15px_rgba(52,211,153,0.15)]';
  if (value >= 40) return 'text-cyan-400 border-cyan-500/40 bg-cyan-950/30 shadow-[0_0_15px_rgba(6,182,212,0.15)]';
  return 'text-rose-400 border-rose-500/40 bg-rose-950/30 shadow-[0_0_15px_rgba(244,63,94,0.15)]';
};
---

<Layout title="Global Odds Thermometer">
  <!-- Hero Section -->
  <div class="mb-12 text-center relative">
    <div class="absolute inset-0 -top-10 bg-gradient-to-r from-cyan-500/10 via-purple-500/10 to-blue-500/10 blur-3xl -z-10 rounded-full"></div>
    <span class="text-xs uppercase tracking-widest px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-semibold mb-4 inline-block">
      Live Intelligence Feed
    </span>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 bg-gradient-to-r from-white via-gray-200 to-gray-400 bg-clip-text text-transparent">
      Global Odds Thermometer
    </h1>
    <p class="text-gray-400 max-w-xl mx-auto text-base">
      Real-time probabilistic forecasts for major tech breakthroughs, economic shifts, and global events, driven by autonomous AI analytics.
    </p>
  </div>

  <!-- Predictions Grid / List -->
  <div class="grid gap-4">
    {predictions.map((item) => (
      <a href={`/predictions/${item.slug}`} class="block p-6 rounded-2xl border border-gray-800/80 bg-gradient-to-br from-[#131B2E] to-[#0D1322] hover:border-cyan-500/50 transition-all duration-300 group shadow-xl hover:shadow-2xl hover:-translate-y-0.5">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2 flex-grow">
            <div class="flex items-center gap-3">
              <span class="text-xs px-2.5 py-1 rounded-md bg-gray-800/80 text-cyan-400 font-medium border border-gray-700/50">
                {item.category}
              </span>
              <span class={`text-xs font-semibold ${item.trendUp ? 'text-emerald-400' : 'text-rose-400'}`}>
                {item.trend}
              </span>
            </div>
            <h2 class="text-lg md:text-xl font-bold text-gray-100 group-hover:text-cyan-300 transition-colors">
              {item.title}
            </h2>
          </div>

          <!-- Probability Badge -->
          <div class="flex items-center justify-between md:justify-end gap-4 shrink-0">
            <div class="text-right hidden md:block">
              <div class="text-[10px] text-gray-500 uppercase tracking-wider font-semibold">Probability</div>
              <div class="text-xs text-gray-400">AI Model Consensus</div>
            </div>
            <div class={`text-2xl font-black px-5 py-2.5 rounded-xl border flex items-center justify-center min-w-[90px] ${getNeonColor(item.odds)}`}>
              {item.odds}%
            </div>
          </div>
        </div>
        <p class="text-sm text-gray-400 mt-4 line-clamp-2 font-normal">
          {item.summary}
        </p>
      </a>
    ))}
  </div>
</Layout>
